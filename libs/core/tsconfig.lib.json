{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../diff/tsconfig.lib.json" },
    { "path": "../terminal-tmux/tsconfig.lib.json" },
    { "path": "../terminal-pty/tsconfig.lib.json" },
    { "path": "../logger/tsconfig.lib.json" },
    { "path": "../review-comments/tsconfig.lib.json" },
    { "path": "../worktree-manager/tsconfig.lib.json" },
    { "path": "../vcs/core/tsconfig.lib.json" },
    { "path": "../terminal/tsconfig.lib.json" }
  ],
  "exclude": [
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx"
  ]
}
