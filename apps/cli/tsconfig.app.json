{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Declarations go beside the build output, not into it: `dist` is
    // the esbuild bundle's directory and the esbuild executor clears it
    // on every build, which deletes the .d.ts files `tsconfig.spec.json`
    // resolves this project through — `nx build cli` would leave
    // `nx typecheck cli` failing with TS6305 until it re-emitted.
    "outDir": "out-tsc/app",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-utils/**"
  ],
  "references": [
    {
      "path": "../../libs/diff/tsconfig.lib.json"
    },
    {
      "path": "../../libs/image-loader/tsconfig.lib.json"
    },
    {
      "path": "../../libs/kitty-graphics/tsconfig.lib.json"
    },
    {
      "path": "../../libs/review-comments/tsconfig.lib.json"
    },
    {
      "path": "../../libs/worktree-manager/tsconfig.lib.json"
    },
    {
      "path": "../../libs/vcs/github/tsconfig.lib.json"
    },
    {
      "path": "../../libs/vcs/core/tsconfig.lib.json"
    },
    {
      "path": "../../libs/vcs/azure-devops/tsconfig.lib.json"
    },
    {
      "path": "../../libs/terminal-tmux/tsconfig.lib.json"
    },
    {
      "path": "../../libs/terminal-pty/tsconfig.lib.json"
    },
    {
      "path": "../../libs/terminal/tsconfig.lib.json"
    },
    {
      "path": "../../libs/logger/tsconfig.lib.json"
    },
    {
      "path": "../../libs/engine/tsconfig.lib.json"
    },
    {
      "path": "../../libs/core/tsconfig.lib.json"
    },
    {
      "path": "../../libs/app-core/tsconfig.lib.json"
    }
  ]
}
